{
  "_comment": [
    "Browser verification plan for scripts/browser/drive.mjs (startSweep).",
    "One entry per tool: fixtures are files from test-files/ dropped on the tool's .drop zone,",
    "text goes in the first textarea ('@b64:<file>' means that fixture base64-encoded), set fills",
    "fields matched by their visible label, prefix keeps the produced files apart in test-files/out/.",
    "compress-video is absent on purpose: there is no video fixture and generating a real one is not",
    "part of this build, so the report says 'not covered' instead of pretending it passed."
  ],
  "prefix": "sweep",
  "results": "sweep-all.json",
  "tools": [
    { "tool": "compress-pdf", "fixtures": ["sample-long.pdf"], "prefix": "compress-pdf", "wait": 800 },
    { "tool": "merge-pdf", "fixtures": ["sample-a.pdf", "sample-b.pdf"], "prefix": "merge-pdf", "wait": 800 },
    { "tool": "split-pdf", "fixtures": ["sample-a.pdf"], "prefix": "split-pdf", "wait": 800 },
    { "tool": "split-pdf", "fixtures": ["sample-long.pdf"], "set": { "mode": "each" }, "prefix": "split-each", "wait": 1500 },
    { "tool": "rotate-pdf", "fixtures": ["sample-a.pdf"], "prefix": "rotate-pdf", "wait": 800 },
    { "tool": "watermark-pdf", "fixtures": ["sample-a.pdf"], "prefix": "watermark-pdf", "wait": 800 },
    { "tool": "pdf-to-jpg", "fixtures": ["sample-a.pdf"], "prefix": "pdf-to-jpg", "wait": 1500, "rafShim": true, "_why": "pdf.js paces its render loop with requestAnimationFrame, and the driver tab is hidden, so no frames arrive — without the shim this row hangs at 261 s and produces nothing (see drive.mjs installRafShim)" },
    { "tool": "pdf-to-text", "fixtures": ["sample-a.pdf"], "prefix": "pdf-to-text", "wait": 1200 },
    { "tool": "images-to-pdf", "fixtures": ["photo.png", "icon.png"], "prefix": "images-to-pdf", "wait": 800 },
    { "tool": "html-to-pdf", "text": "<h1>Hello</h1><p>World</p>", "prefix": "html-to-pdf", "wait": 900,
      "noClick": true, "expect": ["<h1>Hello"],
      "_why": "its only action is window.print(), which blocks the tab: the preview render is what can be checked here, the print step is a manual test" },

    { "tool": "compress-image", "fixtures": ["photo.png"], "prefix": "compress-image", "wait": 1200 },
    { "tool": "convert-image", "fixtures": ["photo.png"], "prefix": "convert-image", "wait": 1200 },
    { "tool": "resize-image", "fixtures": ["photo.png"], "prefix": "resize-image", "wait": 1200 },
    { "tool": "image-to-base64", "fixtures": ["photo-small.png"], "prefix": "image-to-base64", "wait": 1200 },
    { "tool": "base64-to-image", "text": "@b64:photo-small.png", "prefix": "base64-to-image", "wait": 1500 },
    { "tool": "qr-code-generator", "text": "https://example.com/page?a=1", "prefix": "qr-code", "wait": 1200 },
    { "tool": "favicon-generator", "fixtures": ["photo.png"], "prefix": "favicon", "wait": 1200 },
    { "tool": "color-picker", "prefix": "color-picker", "wait": 600 },
    { "tool": "image-to-gif", "fixtures": ["photo.png", "photo-small.png"], "prefix": "image-to-gif", "wait": 2500 },
    { "tool": "trim-audio", "fixtures": ["tone.wav"], "prefix": "trim-audio", "wait": 1500 },
    { "tool": "image-contrast-brightness", "fixtures": ["photo.png"], "prefix": "contrast-image", "wait": 1200 },

    { "tool": "word-counter", "text": "The quick brown fox jumps over the lazy dog. Again and again.", "prefix": "word-counter", "wait": 300 },
    { "tool": "case-converter", "text": "hello WORLD once more", "prefix": "case-converter", "wait": 300 },
    { "tool": "remove-duplicate-lines", "text": "a\nb\na\nc\nb\n", "prefix": "dedupe", "wait": 300 },
    { "tool": "lorem-ipsum-generator", "prefix": "lorem", "wait": 600 },
    { "tool": "base64-encode-decode", "text": "Hello, world! 你好", "prefix": "b64-text", "wait": 300 },
    { "tool": "url-encode-decode", "text": "a b&c=中文/é", "prefix": "url-codec", "wait": 300 },
    { "tool": "html-entities", "text": "<p>Tom & Jerry’s “quotes”</p>", "prefix": "entities", "wait": 300 },
    { "tool": "reverse-text", "text": "abcdef 12345", "prefix": "reverse", "wait": 300 },
    { "tool": "json-formatter", "text": "{\"a\":1,\"b\":[2,3],\"c\":{\"d\":\"x\"}}", "prefix": "json", "wait": 300 },
    { "tool": "csv-to-json", "text": "name,age\nAnn,31\nBo,25", "prefix": "csv", "wait": 300 },
    { "tool": "markdown-to-html", "text": "# Title\n\nSome **bold** text and a [link](https://example.com).", "prefix": "md", "wait": 600 },
    { "tool": "hash-generator", "text": "hello", "prefix": "hash", "wait": 300 },
    { "tool": "uuid-generator", "prefix": "uuid", "wait": 300 },
    { "tool": "password-generator", "prefix": "password", "wait": 300 },
    { "tool": "regex-tester", "text": "order 4821 and order 9015", "prefix": "regex", "wait": 300 },
    { "tool": "diff-checker", "text": "alpha\nbeta\ngamma", "prefix": "diff", "wait": 300 },
    { "tool": "text-to-speech", "text": "Hello there", "prefix": "tts", "wait": 300 },

    { "tool": "percentage-calculator", "prefix": "percentage", "wait": 300 },
    { "tool": "bmi-calculator", "prefix": "bmi", "wait": 300 },
    { "tool": "age-calculator", "prefix": "age", "wait": 300 },
    { "tool": "date-calculator", "prefix": "date", "wait": 300 },
    { "tool": "loan-calculator", "prefix": "loan", "wait": 300 },
    { "tool": "discount-calculator", "prefix": "discount", "wait": 300 },
    { "tool": "unit-converter", "prefix": "units", "wait": 300 },
    { "tool": "color-converter", "prefix": "color", "wait": 300 },
    { "tool": "calorie-calculator", "prefix": "calorie", "wait": 300 },
    { "tool": "timestamp-converter", "prefix": "timestamp", "wait": 300 },
    { "tool": "random-number-generator", "prefix": "random", "wait": 300 }
  ]
}
